# ORBIT example environment (development only).
# Copy to .env and adjust. NEVER commit real credentials.

ORBIT_ENV=development
# deploy/compose/compose.yaml binds Postgres (5432) and NATS (4222) to 127.0.0.1. The API
# (8080) and web (3000) listen on all interfaces and run dev auth, so do not expose the
# host to an untrusted network. deploy/compose/compose.dev.yaml binds everything on all
# interfaces.
# Compose does not read this file from the repository root by itself. Pass it explicitly:
#   docker compose --env-file .env -f deploy/compose/compose.yaml ...

# ---------------------------------------------------------------- authentication
# dev  = seeded local user, no external IdP (default for local development)
# oidc = validate bearer tokens against an OIDC provider's JWKS
# ORBIT_AUTH_MODE=dev is refused when ORBIT_ENV=production.
ORBIT_AUTH_MODE=dev
ORBIT_DEV_AUTH_ALLOW_ANONYMOUS=true
ORBIT_DEV_TOKEN=orbit-dev-token
ORBIT_DEV_USER_EMAIL=dev@orbit.local
ORBIT_DEV_USER_NAME=ORBIT Developer
ORBIT_DEV_ORG_SLUG=orbit
ORBIT_DEV_ORG_NAME=ORBIT
ORBIT_SEED_DEMO=true
# Role of the dev user (owner, admin, operator or viewer; default owner).
# ORBIT_DEV_USER_ROLE=owner
# Set to false to reject API tokens (orbit_sk_...) in any auth mode (default true).
# ORBIT_ALLOW_API_TOKENS=true

# OIDC (required when ORBIT_AUTH_MODE=oidc)
# ORBIT_OIDC_ISSUER=https://dex.example.com
# ORBIT_OIDC_AUDIENCE=orbit
# ORBIT_OIDC_CLIENT_ID=orbit
# ORBIT_OIDC_CLIENT_SECRET=
# ORBIT_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# ORBIT_OIDC_JWKS_URL=https://dex.example.com/keys
# ORBIT_OIDC_SCOPES=openid profile email
# ORBIT_OIDC_AUTO_PROVISION=true
# ORBIT_OIDC_DEFAULT_ROLE=viewer
# ORBIT_OIDC_ROLE_CLAIM=groups
# ORBIT_OIDC_EMAIL_CLAIM=email
# ORBIT_OIDC_GROUP_ROLES=orbit-admins=admin,orbit-operators=operator
# ORBIT_OIDC_TEAM_GROUPS=platform=platform:member
# ORBIT_OIDC_AUTO_CREATE_TEAMS=false
# ORBIT_OIDC_REQUIRE_MAPPED_GROUP=false
# ORBIT_OIDC_SYNC_ROLES=false
# ORBIT_OIDC_REQUIRE_VERIFIED_EMAIL=false
# Allowed clock difference when validating token times, in seconds (default 60).
# ORBIT_OIDC_CLOCK_SKEW_SECONDS=60

# Scoped execution-plane worker token. Compose refuses to load without it. Issue one from
# the API once it is running (docs/development/local.md has the exact sequence):
#   curl -X POST -H "Authorization: Bearer $ORBIT_DEV_TOKEN" \
#     -d '{"name":"local-mock","harnesses":["mock"]}' \
#     http://localhost:8080/api/v1/worker-tokens
# ORBIT_WORKER_TOKEN=orbit_wk_...
# Launcher: internal API<->launcher credential. The launcher holds the Docker socket,
# so its port is NOT published by Compose and the default token
# (orbit-dev-launcher-token) is only reachable on the Compose network. Set a random
# value (openssl rand -base64 36) for anything beyond a local machine.
# ORBIT_LAUNCHER_TOKEN=
# Compose-only launcher settings (see docs/development/local.md):
# Host path of the OpenCode auth export that Docker-launched workers mount.
# ORBIT_OPENCODE_AUTH_HOST_PATH=/Users/me/orbit/.orbit-auth-export.json
# Host path of the Pi agent directory (the contents of ~/.pi/agent).
# ORBIT_PI_AGENT_HOST_DIR=/Users/me/.pi/agent
# Rewrite image registry hosts before the launcher starts a container (from=to pairs).
# ORBIT_LAUNCHER_IMAGE_ALIASES=192.168.1.201:5000=registry.mdk.local:5000
# Group id that owns /var/run/docker.sock. Linux: stat -c %g /var/run/docker.sock
# Docker Desktop: leave the default 0.
# DOCKER_GID=0

# ------------------------------------------------------------------------ storage
ORBIT_DATABASE_URL=postgres://orbit:orbit@db:5432/orbit
ORBIT_DB_MAX_CONNECTIONS=10
ORBIT_DB_AUTO_MIGRATE=true

# 32-byte base64 master key used to encrypt provider/connector credentials at rest.
# Generate: openssl rand -base64 32
# The value below is a documented DEVELOPMENT key. Replace it for production.
ORBIT_MASTER_KEY=b3JiaXQtZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMhISE=

# ------------------------------------------------------------------------- events
ORBIT_EVENTS_DRIVER=nats
ORBIT_NATS_URL=nats://nats:4222
ORBIT_NATS_STREAM=ORBIT
# Size cap of the JetStream stream in bytes (default 1 GiB; the oldest events are dropped
# first). The stream keeps every execution event for 7 days and nothing reads it durably.
# ORBIT_NATS_STREAM_MAX_BYTES=1073741824

# -------------------------------------------------------------------------- http
ORBIT_HTTP_ADDR=0.0.0.0:8080
ORBIT_CORS_ORIGINS=http://localhost:3000
ORBIT_PUBLIC_BASE_URL=http://localhost:8080
# Per-source-IP budget for unauthenticated/public endpoints (health, metrics, meta,
# OIDC helpers, OpenAPI/Swagger), in requests per 60-second window (default 120).
# Returns 429 with the standard error envelope when exceeded. Authenticated API and
# worker routes are not affected. Behind an L7 proxy the source IP is the proxy peer;
# keep proxy-side client-IP limits as well.
# ORBIT_ANON_RATE_LIMIT_PER_MINUTE=120
ORBIT_LOG_FORMAT=text
# Outbound URL policy for provider, output and work-source URLs (see
# docs/guide/providers.md). Private ranges are allowed by default.
# ORBIT_OUTBOUND_ALLOW_PRIVATE=true
# ORBIT_OUTBOUND_ALLOWED_HOSTS=ollama.internal,10.0.0.0/8

# ------------------------------------------------------------------------ worker
ORBIT_WORKER_CONCURRENCY=4
ORBIT_WORKER_POLL_MS=500
# Note: no component currently reads ORBIT_SCHEDULER_ENABLED; schedules run in the API.
ORBIT_SCHEDULER_ENABLED=true
ORBIT_WORKSPACE_ROOT=/tmp/orbit-workspaces

# --------------------------------------------------------------------------- web
# Runtime-only server-side proxy target (not exposed to the browser).
ORBIT_API_INTERNAL_URL=http://api:8080
# Inject the dev bearer token server-side (dev mode only; leave empty for OIDC).
ORBIT_WEB_DEV_TOKEN=orbit-dev-token
# Only for a browser-reachable direct API (split domains). Leave unset for the same-origin
# proxy. NEXT_PUBLIC_ values are compiled into the browser bundle at build time.
# NEXT_PUBLIC_ORBIT_API_URL=
