{
  "name": "orbit",
  "private": true,
  "version": "0.31.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @orbit/web dev",
    "build": "pnpm --filter @orbit/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "api:generate": "node scripts/generate-api-client.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/changelog.mjs check && node --test scripts/changelog.test.mjs",
    "changelog": "node scripts/changelog.mjs"
  }
}
